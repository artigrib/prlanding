{
  "_comment": "Import policy for sim/so101/objects. Edit only after a human licence/brand review. See docs/objects.md.",
  "budget": {
    "glb_max_bytes": 307200,
    "texture_sizes": [
      512,
      384,
      256,
      192,
      128
    ],
    "triangle_targets": [
      16000,
      10000,
      6000,
      3500,
      2000
    ],
    "max_hulls": 12,
    "max_hull_vertices": 48,
    "max_size_m": 0.35,
    "min_size_m": 0.01,
    "max_mass_kg": 2.0,
    "max_download_bytes_per_asset": 200000000
  },
  "defaults": {
    "density_kg_m3": 600,
    "friction": 0.8,
    "torsional_friction": 0.01,
    "rolling_friction": 0.001
  },
  "licenses": {
    "allow": {
      "CC0-1.0": "https://creativecommons.org/publicdomain/zero/1.0/",
      "CC-BY-4.0": "https://creativecommons.org/licenses/by/4.0/",
      "CC-BY-3.0": "https://creativecommons.org/licenses/by/3.0/",
      "Apache-2.0": "https://www.apache.org/licenses/LICENSE-2.0",
      "MIT": "https://opensource.org/license/mit",
      "BSD-3-Clause": "https://opensource.org/license/bsd-3-clause",
      "BSD-2-Clause": "https://opensource.org/license/bsd-2-clause"
    },
    "_reviewed_custom_comment": "Non-SPDX licences (e.g. NVIDIA-specific asset terms) are excluded until the owner has read the exact terms and confirmed commercial use AND redistribution of modified copies on a public website. Add them here keyed by the exact licence name or URL the dataset declares, e.g. {\"<name or url>\": {\"url\": \"...\", \"reviewed\": \"YYYY-MM-DD\", \"note\": \"...\"}}.",
    "reviewed_custom": {},
    "deny_patterns": [
      "-NC",
      "NONCOMMERCIAL",
      "-ND",
      "NODERIV",
      "-SA",
      "SHAREALIKE",
      "GPL",
      "RESEARCH",
      "EVALUATION",
      "PROPRIETARY"
    ]
  },
  "brands": {
    "_comment": "Case-insensitive word matches on asset id, name, path and metadata text. A hit excludes the asset unless its spec carries brand_review (a human note saying the object itself shows no mark).",
