# Caddy for printedrobotics.cz backends. Let's Encrypt only (no ZeroSSL fallback), automatic HTTPS.
# No access log is configured, so client IPs and headers are never written to disk.
# Site blocks live in sites/*.caddy; the deploy workflow copies a site into sites-enabled/ only
# after it has checked that the hostname's DNS A record already points at this server.
{
	admin 127.0.0.1:12019
	cert_issuer acme
}

(common) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	request_body {
		max_size 64KB
	}
}

# Internal health endpoint for the container healthcheck (loopback only; Caddy uses host networking).
http://127.0.0.1:18199 {
	bind 127.0.0.1
	respond /health "ok" 200
	respond 404
}

# Explicit HTTP->HTTPS redirect (same 308 as Caddy's automatic one; ACME challenges are still
# answered by Caddy before any route). X-PR-Edge lets the ops "tls" check confirm that it is this
# Caddy, and not some other server, that answers port 80 from the internet.
http://api.printedrobotics.cz, http://mcp.printedrobotics.cz, http://relay.printedrobotics.cz {
	header X-PR-Edge 1
	redir https://{host}{uri} 308
}

import sites-enabled/*.caddy
