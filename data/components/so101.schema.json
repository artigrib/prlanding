{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://printedrobotics.cz/data/components/so101.schema.json",
  "title": "SO-101 component map and purchase plans",
  "description": "Checked by tools/check-components.mjs on every build (node tools/build.mjs). Every source needs an https URL, a checked date and a status. We are not a seller: sources are suppliers the user buys from directly.",
  "type": "object",
  "required": [
    "meta",
    "suppliers",
    "variants",
    "configs",
    "printing",
    "tools",
    "build_time",
    "arrivals",
    "components"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "robot",
        "generated",
        "fx_czk_per_eur",
        "oss_vat_uplift",
        "affiliate_links",
        "status_legend"
      ],
      "properties": {
        "robot": {
          "type": "string"
        },
        "generated": {
          "$ref": "#/$defs/date"
        },
        "fx_czk_per_eur": {
          "type": "number",
          "minimum": 10,
          "maximum": 50
        },
        "fx_ron_per_eur": {
          "type": "number"
        },
        "oss_vat_uplift": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.1
        },
        "license": {
          "description": "Licence of the robot project, same shape as license in assets/data.js; rights are derived from it (PR_DERIVE_RIGHTS).",
          "type": "object",
          "required": ["hw", "status", "checked", "sources"],
          "properties": {
            "hw": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "array", "items": { "type": "string" }, "minItems": 1 }] },
            "sw": { "type": "string" },
            "status": { "enum": ["verified", "unverified"] },
            "checked": { "$ref": "#/$defs/date" },
            "sources": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
          }
        },
        "affiliate_links": {
          "type": "boolean"
        },
        "status_legend": {
          "type": "object"
        }
      }
    },
    "suppliers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "country",
          "url",
          "vat",
          "shipping_eur",
          "shipping_status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "$ref": "#/$defs/url"
          },
          "vat": {
            "enum": [
              "eu_oss",
              "cz",
              "cz_nonvat",
              "cn_ioss",
              "non_eu",
              "per_vendor",
              "none"
            ]
          },
          "shipping_eur": {
            "$ref": "#/$defs/range"
          },
          "shipping_status": {
            "$ref": "#/$defs/status"
          },
          "eta_days_estimate": {
            "$ref": "#/$defs/range"
          },
          "duty_eur_per_line": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "variants": {
      "type": "object",
      "required": [
        "codes",
        "arms",
        "rules",
        "rules_cs",
        "how_to_verify",
        "how_to_verify_cs"
      ],
      "properties": {
        "codes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "voltage_v",
              "gear_ratio",
              "status"
            ],
            "properties": {
              "voltage_v": {
                "type": "number"
              },
              "gear_ratio": {
                "type": "string",
                "pattern": "^1/[0-9]{3}$"
              },
              "status": {
                "$ref": "#/$defs/status"
              }
            }
          }
        },
        "arms": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "voltage_v",
              "joints"
            ],
            "properties": {
              "voltage_v": {
                "type": "number"
              },
              "joints": {
                "type": "array",
                "minItems": 6,
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "required": [
                    "joint",
                    "name",
                    "codes"
                  ],
                  "properties": {
                    "joint": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 6
                    },
                    "name": {
                      "type": "string"
                    },
                    "codes": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "configs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "name_cs",
          "arms",
          "lines",
          "print_grams"
        ],
        "properties": {
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "component",
                "qty",
                "source"
              ],
              "properties": {
                "component": {
                  "type": "string"
                },
                "qty": {
                  "type": "integer",
                  "minimum": 1
                },
                "source": {
                  "type": "string"
                },
                "arm": {
                  "type": "string"
                }
              }
            }
          },
          "print_grams": {
            "type": "number",
            "minimum": 1
          }
        }
      }
    },
    "kits_note": {
      "type": "string"
    },
    "kits": {
      "type": "array",
      "description": "Ready-made kits compared with buying the parts separately (plan-core compareKits). landed_eur_cz must equal plan-core kitLanded(); servo mix of a verified kit must fit each listed config. No affiliate links.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "name_cs",
          "seller",
          "url",
          "configs",
          "price",
          "currency",
          "servos",
          "includes",
          "missing",
          "missing_print",
          "missing_other",
          "missing_other_cs",
          "assembled",
          "printed",
          "ships_cz",
          "buyers",
          "in_stock",
          "stock",
          "import",
          "landed_eur_cz",
          "checked",
          "status",
          "note",
          "note_cs",
          "reviews"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "name_cs": {
            "type": "string",
            "minLength": 1
          },
          "seller": {
            "type": "string",
            "description": "key of suppliers"
          },
          "url": {
            "$ref": "#/$defs/url"
          },
          "configs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "price": {
            "$ref": "#/$defs/range"
          },
          "currency": {
            "enum": [
              "EUR",
              "CZK",
              "RON"
            ]
          },
          "price_note": {
            "type": "string"
          },
          "price_note_cs": {
            "type": "string"
          },
          "servos": {
            "type": "object",
            "description": "per arm id: voltage, gear-ratio counts, optional code counts (only when the listing names codes)",
            "additionalProperties": {
              "type": "object",
              "required": [
                "voltage_v",
                "ratios"
              ],
              "additionalProperties": false,
              "properties": {
                "voltage_v": {
                  "type": "number"
                },
                "ratios": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "codes": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          },
          "includes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/kit_item"
            }
          },
          "missing": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/kit_item"
            },
            "description": "components still to buy, priced from the plan's source for that component"
          },
          "missing_print": {
            "type": "boolean",
            "description": "printed parts not included: add the chosen print option's cost"
          },
          "missing_other": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing_other_cs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assembled": {
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "printed": {
            "enum": [
              "included",
              "not_included"
            ]
          },
          "ships_cz": {
            "enum": [
              "yes",
              "no",
              "unverified"
            ]
          },
          "buyers": {
            "enum": [
              "consumers",
              "business_only"
            ]
          },
          "in_stock": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "stock": {
            "type": "string"
          },
          "eta_days": {
            "$ref": "#/$defs/range"
          },
          "shipping_eur": {
            "$ref": "#/$defs/range"
          },
          "import": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "vat_rate",
                  "duty_rate",
                  "clearance_eur",
                  "price_includes_vat",
                  "note",
                  "note_cs"
                ],
                "properties": {
                  "vat_rate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "duty_rate": {
                    "$ref": "#/$defs/range"
                  },
                  "clearance_eur": {
                    "$ref": "#/$defs/range"
                  },
                  "price_includes_vat": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "status": {
                    "$ref": "#/$defs/status"
                  },
                  "note": {
                    "type": "string"
                  },
                  "note_cs": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "landed_eur_cz": {
            "$ref": "#/$defs/range"
          },
          "checked": {
            "$ref": "#/$defs/date"
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "note": {
            "type": "string"
          },
          "note_cs": {
            "type": "string"
          },
          "reviews": {
            "$ref": "#/$defs/reviews"
          }
        }
      }
    },
    "printing": {
      "type": "object",
      "required": [
        "self",
        "service"
      ],
      "properties": {
        "self": {
          "type": "object",
          "required": [
            "filament_czk_per_kg",
            "status"
          ],
          "properties": {
            "status": {
              "$ref": "#/$defs/status"
            }
          }
        },
        "service": {
          "type": "object",
          "required": [
            "price_eur_per_arm",
            "status",
            "eta_days",
            "sources"
          ],
          "properties": {
            "price_eur_per_arm": {
              "$ref": "#/$defs/range"
            },
            "eta_days": {
              "$ref": "#/$defs/range"
            },
            "status": {
              "$ref": "#/$defs/status"
            }
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "name_cs",
          "required"
        ]
      }
    },
    "build_time": {
      "type": "object",
      "required": [
        "status",
        "guide",
        "printer_h_per_arm",
        "stages"
      ],
      "properties": {
        "status": {
          "const": "estimate"
        },
        "printer_h_per_arm": {
          "type": "number",
          "minimum": 0
        },
        "guide": {
          "type": "object",
          "required": [
            "cs",
            "en"
          ]
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "name_cs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^e[0-9]$"
              },
              "h": {
                "$ref": "#/$defs/range"
              },
              "h_per_arm": {
                "$ref": "#/$defs/range"
              },
              "only_print": {
                "enum": [
                  "self",
                  "service"
                ]
              },
              "optional": {
                "type": "boolean"
              },
              "printer": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "arrivals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "name_cs",
          "needed_for_wizard",
          "guide_stage"
        ],
        "properties": {
          "guide_stage": {
            "type": "string",
            "pattern": "^e[0-9]$"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "group",
          "name",
          "name_cs",
          "role",
          "role_cs",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^so101\\."
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "supplier",
                "label",
                "url",
                "checked",
                "status",
                "recommend",
                "price",
                "currency",
                "per",
                "eta_days"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "supplier": {
                  "type": "string"
                },
                "url": {
                  "$ref": "#/$defs/url"
                },
                "checked": {
                  "$ref": "#/$defs/date"
                },
                "status": {
                  "$ref": "#/$defs/status"
                },
                "recommend": {
                  "type": "boolean"
                },
                "price": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "currency": {
                  "enum": [
                    "EUR",
                    "CZK",
                    "RON",
                    "GBP",
                    null
                  ]
                },
                "per": {
                  "type": "integer",
                  "minimum": 1
                },
                "eta_days": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/range"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "flag": {
                  "enum": [
                    "mislabeled",
                    "variant_not_shown",
                    "check_label",
                    "out_of_stock"
                  ]
                },
                "reviews": {
                  "$ref": "#/$defs/reviews"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
    },
    "url": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "status": {
      "enum": [
        "verified",
        "carried",
        "unverified",
        "estimate"
      ]
    },
    "kit_item": {
      "type": "object",
      "required": [
        "component",
        "qty"
      ],
      "additionalProperties": false,
      "properties": {
        "component": {
          "type": "string"
        },
        "qty": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "reviews": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "rating",
            "count",
            "checked",
            "signals"
          ],
          "properties": {
            "rating": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 5
            },
            "count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "checked": {
              "$ref": "#/$defs/date"
            },
            "url": {
              "$ref": "#/$defs/url"
            },
            "signals": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "type",
                  "note_cs",
                  "note_en"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "variant_mismatch",
                      "shipping_time",
                      "quality",
                      "missing_parts",
                      "positive"
                    ]
                  },
                  "note_cs": {
                    "type": "string",
                    "minLength": 1
                  },
                  "note_en": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ],
      "description": "Buyer reviews on the listing, summarised by us (never copied verbatim). count 0 = the listing has no reviews; null = could not be read."
    }
  }
}
