{
 "$schema": "../schema/device.schema.json",
 "$comment": "SO-101 device package. The MJCF stays where the website serves it (sim/so101/model); the mount library (mounts.json) is generated by tools/measure_so101.py in this package.",
 "id": "so101",
 "name": "SO-101 robot arm",
 "kind": "arm",
 "units": "mm",
 "licence": {"model": "Apache-2.0", "source": "MuJoCo Menagerie robotstudio_so101", "notice": "sim/so101/model/LICENSE"},
 "model": {"dir": "sim/so101/model", "xml": "so101.xml", "scene": "scene.xml", "meshdir": "assets"},
 "mounts": "devices/so101/mounts.json",
 "ports": "devices/so101/ports.json",
 "components": "data/components/so101.json",
 "checks": "checks.json",
 "tcp_site": "gripperframe",
 "attach_bodies": ["gripper", "lower_arm", "upper_arm", "shoulder", "base"],
 "moves_with": ["gripper", "forearm", "any"],
 "default_mount": "gripper_cam_face",
 "sandwich": {"gripper_cam_face": "camera_mount"},
 "joints": {
  "all": ["shoulder_pan", "shoulder_lift", "elbow_flex", "wrist_flex", "wrist_roll", "gripper"],
  "torque": ["shoulder_lift", "elbow_flex", "wrist_flex", "wrist_roll", "gripper"]
 },
 "sweep": {
  "quick": {"shoulder_lift": 3, "elbow_flex": 3, "wrist_flex": 5, "wrist_roll": 3, "gripper": 2},
  "full": {"shoulder_lift": 5, "elbow_flex": 5, "wrist_flex": 11, "wrist_roll": 9, "gripper": 4},
  "torque": {"shoulder_lift": 9, "elbow_flex": 9, "wrist_flex": 9, "wrist_roll": 5}
 },
 "poses": {"work": {"shoulder_pan": 0.0, "shoulder_lift": -0.35, "elbow_flex": 0.55, "wrist_flex": 1.15, "wrist_roll": 0.0, "gripper": 0.45}},
 "actuators": {"stall_nm": {"C018 12 V (30 kg·cm)": 2.94, "C001 7.4 V (16.5 kg·cm at 6 V)": 1.62}},
 "prompt": {"name": "SO-101", "scope": "a small printable add-on for the SO-101 arm (holders, brackets, clips, tool tips, cable guides, small low-voltage electronics up to 12 V)"}
}
