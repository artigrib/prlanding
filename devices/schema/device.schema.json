{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "device.schema.json",
 "title": "Device package manifest (devices/<id>/device.json)",
 "type": "object",
 "required": [
  "id",
  "name",
  "units",
  "model",
  "mounts",
  "joints",
  "sweep",
  "prompt"
 ],
 "properties": {
  "$schema": {
   "type": "string"
  },
  "$comment": {
   "type": "string"
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9_]+$"
  },
  "name": {
   "type": "string"
  },
  "kind": {
   "type": "string",
   "enum": [
    "arm",
    "quadruped",
    "humanoid",
    "wheeled",
    "other"
   ]
  },
  "units": {
   "type": "string",
   "enum": [
    "mm"
   ]
  },
  "licence": {
   "type": "object",
   "properties": {
    "model": {
     "type": "string"
    },
    "source": {
     "type": "string"
    },
    "notice": {
     "type": "string"
    }
   }
  },
  "model": {
   "type": "object",
   "required": [
    "dir",
    "xml"
   ],
   "properties": {
    "dir": {
     "type": "string",
     "description": "repo-relative directory of the MJCF (may live outside devices/, e.g. the site's sim/so101/model)"
    },
    "xml": {
     "type": "string"
    },
    "scene": {
     "type": "string"
    },
    "meshdir": {
     "type": "string"
    },
    "overlay": {
     "type": "string"
    }
   }
  },
  "mounts": {
   "type": "string",
   "description": "repo-relative path of mounts.json"
  },
  "ports": {
   "type": "string"
  },
  "components": {
   "type": "string"
  },
  "checks": {
   "type": "string",
   "description": "path of checks.json relative to the device dir"
  },
  "tcp_site": {
   "type": "string"
  },
  "attach_bodies": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "moves_with": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "minItems": 1
  },
  "default_mount": {
   "type": "string"
  },
  "sandwich": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "joints": {
   "type": "object",
   "required": [
    "torque"
   ],
   "properties": {
    "all": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "torque": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1
    }
   }
  },
  "sweep": {
   "type": "object",
   "required": [
    "quick",
    "full",
    "torque"
   ],
   "properties": {
    "quick": {
     "$ref": "#/$defs/grid"
    },
    "full": {
     "$ref": "#/$defs/grid"
    },
    "torque": {
     "$ref": "#/$defs/grid"
    }
   }
  },
  "poses": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "additionalProperties": {
     "type": "number"
    }
   }
  },
  "actuators": {
   "type": "object",
   "properties": {
    "stall_nm": {
     "type": "object",
     "additionalProperties": {
      "type": "number",
      "exclusiveMinimum": 0
     }
    },
    "limit_from_model": {
     "type": "boolean",
     "description": "joint torque limits = MJCF motor ctrlrange"
    }
   }
  },
  "prompt": {
   "type": "object",
   "required": [
    "name",
    "scope"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "scope": {
     "type": "string"
    }
   }
  },
  "agent": {
   "type": "boolean",
   "description": "offer this device to the LLM agent (prompt enum); false = forge tools/tests only"
  },
  "base": {
   "type": "object",
   "properties": {
    "body": {
     "type": "string"
    },
    "floating": {
     "type": "boolean"
    }
   }
  },
  "legs": {
   "type": "object",
   "additionalProperties": {
    "type": "array",
    "items": {
     "type": "string"
    },
    "minItems": 1
   },
   "description": "leg name -> its joints (floating-base robots)"
  },
  "feet": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   },
   "description": "leg name -> foot geom name"
  },
  "poses_note": {
   "type": "string"
  },
  "payload": {
   "type": "object",
   "properties": {
    "nominal_g": {
     "type": [
      "number",
      "null"
     ]
    },
    "max_g": {
     "type": [
      "number",
      "null"
     ]
    },
    "source": {
     "type": "string"
    },
    "verified": {
     "type": "boolean"
    }
   }
  }
 },
 "$defs": {
  "grid": {
   "type": "object",
   "additionalProperties": {
    "type": "integer",
    "minimum": 1
   }
  }
 }
}
