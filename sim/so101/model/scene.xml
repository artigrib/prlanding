<!-- printedrobotics.cz: SO-101 on a table with cubes, bowls, a ball and a goal (missions in src/missions.js). -->
<mujoco model="so101_mission">
  <include file="so101.xml"/>
  <option timestep="0.004"/>
  <default>
    <default class="bowlwall">
      <geom type="box" size="0.003 0.024 0.014" group="3"/>
    </default>
  </default>
  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <!-- floor (not drawn) so a dropped object comes to rest; unused mission objects are parked on it -->
    <geom name="floor" type="plane" size="3 3 0.1" pos="0 0 -0.75" group="3"/>
    <!-- table top: upper surface at z = 0 -->
    <geom name="table" type="box" size="0.40 0.32 0.015" pos="0.14 0 -0.015" rgba="0.93 0.93 0.92 1" friction="0.8 0.005 0.0001"/>
    <!-- cube (mission 1); drawn by app.js -->
    <body name="cube" pos="0.25 -0.11 0.0125">
      <freejoint name="cube"/>
      <geom name="cube" type="box" size="0.0125 0.0125 0.0125" mass="0.015" rgba="0.91 0.27 0.12 1"
        friction="1.2 0.01 0.001" condim="4" solref="0.01 1"/>
    </body>
    <!-- extra mission objects: group 3 here, drawn by src/scene-extras.js -->
    <body name="cube_b" pos="1.0 0.5 -0.7375">
      <freejoint name="cube_b"/>
      <geom name="cube_b" type="box" size="0.0125 0.0125 0.0125" mass="0.015" group="3"
        friction="1.2 0.01 0.001" condim="4" solref="0.01 1"/>
    </body>
    <body name="ball" pos="1.0 -0.5 -0.73">
      <freejoint name="ball"/>
      <geom name="ball" type="sphere" size="0.02" mass="0.012" group="3"
        friction="0.6 0.005 0.0008" condim="6" solref="0.01 1"/>
    </body>
    <!-- bowls are mocap bodies so each mission can place them; flat bottom + octagonal wall -->
    <body name="bowl" pos="0.20 0.15 0" mocap="true">
      <geom name="bowl_bottom" type="cylinder" size="0.055 0.002" pos="0 0 0.002" rgba="0.2 0.2 0.2 1" group="3"/>
      <geom name="bowl_w0" class="bowlwall" pos="0.058 0 0.014" euler="0 0 0"/>
      <geom name="bowl_w1" class="bowlwall" pos="0.041 0.041 0.014" euler="0 0 0.7854"/>
      <geom name="bowl_w2" class="bowlwall" pos="0 0.058 0.014" euler="0 0 1.5708"/>
      <geom name="bowl_w3" class="bowlwall" pos="-0.041 0.041 0.014" euler="0 0 2.3562"/>
      <geom name="bowl_w4" class="bowlwall" pos="-0.058 0 0.014" euler="0 0 0"/>
      <geom name="bowl_w5" class="bowlwall" pos="-0.041 -0.041 0.014" euler="0 0 0.7854"/>
      <geom name="bowl_w6" class="bowlwall" pos="0 -0.058 0.014" euler="0 0 1.5708"/>
      <geom name="bowl_w7" class="bowlwall" pos="0.041 -0.041 0.014" euler="0 0 2.3562"/>
    </body>
    <body name="bowl2" pos="1.5 0.3 -0.75" mocap="true">
      <geom name="bowl2_bottom" type="cylinder" size="0.055 0.002" pos="0 0 0.002" group="3"/>
      <geom name="bowl2_w0" class="bowlwall" pos="0.058 0 0.014" euler="0 0 0"/>
      <geom name="bowl2_w1" class="bowlwall" pos="0.041 0.041 0.014" euler="0 0 0.7854"/>
      <geom name="bowl2_w2" class="bowlwall" pos="0 0.058 0.014" euler="0 0 1.5708"/>
      <geom name="bowl2_w3" class="bowlwall" pos="-0.041 0.041 0.014" euler="0 0 2.3562"/>
      <geom name="bowl2_w4" class="bowlwall" pos="-0.058 0 0.014" euler="0 0 0"/>
      <geom name="bowl2_w5" class="bowlwall" pos="-0.041 -0.041 0.014" euler="0 0 0.7854"/>
      <geom name="bowl2_w6" class="bowlwall" pos="0 -0.058 0.014" euler="0 0 1.5708"/>
      <geom name="bowl2_w7" class="bowlwall" pos="0.041 -0.041 0.014" euler="0 0 2.3562"/>
    </body>
    <!-- goal: low U-shaped fence, open towards the robot (-x in the goal frame) -->
    <body name="goal" pos="1.5 -0.3 -0.75" mocap="true">
      <geom name="goal_back" type="box" size="0.004 0.055 0.01" pos="0.045 0 0.01" group="3"/>
      <geom name="goal_l" type="box" size="0.045 0.004 0.01" pos="0 0.055 0.01" group="3"/>
      <geom name="goal_r" type="box" size="0.045 0.004 0.01" pos="0 -0.055 0.01" group="3"/>
    </body>
  </worldbody>
  <keyframe>
    <key name="home"
      qpos="0 -1.0 0.6 1.2 0 0.3  0.25 -0.11 0.0125 1 0 0 0  1.0 0.5 -0.7375 1 0 0 0  1.0 -0.5 -0.73 1 0 0 0"
      ctrl="0 -1.0 0.6 1.2 0 0.3"/>
  </keyframe>
</mujoco>
